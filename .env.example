# Copy to .env and adjust. Every variable the service reads is listed here.
# .env is git-ignored; never commit real credentials.

# --- Postgres (used by docker-compose and to build DATABASE_URL) ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wallet
# Host port Postgres is published on by docker-compose.
POSTGRES_PORT=5432

# --- Service ---
# Required. Connection string for the service and the migrate command.
# docker-compose overrides the host to reach the postgres container.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
# Address the HTTP server listens on.
HTTP_ADDR=:8080
# Maximum connections in the database pool.
DB_MAX_CONNS=10
# debug | info | warn | error
LOG_LEVEL=info
# Server timeouts (Go durations). HTTP_WRITE_TIMEOUT must exceed REQUEST_TIMEOUT.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Deadline applied to each request's context, including its database calls.
REQUEST_TIMEOUT=10s
# Maximum request body size in bytes.
MAX_BODY_BYTES=1048576
# On SIGTERM: how long readiness fails before the server stops accepting
# connections, then how long in-flight requests get to finish.
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
